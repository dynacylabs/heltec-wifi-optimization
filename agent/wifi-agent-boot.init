#!/bin/sh /etc/rc.common
# Boot-time hook - unlike the old wifi-agent.init, this does not run a
# continuous background service (there's nothing for it to loop on anymore:
# the server initiates all telemetry/command/backup traffic over SSH, see
# wifi-agent.sh's header comment). What still needs to happen automatically,
# independent of whether the server ever reaches this device, is the HaLow
# radio channel recovery check - and, since 2026-08-01, not just at boot.
#
# A bad config applied mid-operation (not at boot) can wedge the radio with
# nothing watching for it until the device's next reboot otherwise -
# confirmed live: an AP's HaLow chip wedged after a failed optimizer apply
# and sat that way for hours since nothing re-checked it between boots. So
# this also registers a periodic cron job for the same check, idempotently,
# rather than relying on boot alone.
START=99

CRON_MARKER="wifi-agent.sh recover-radio"
CRON_LINE="*/15 * * * * /usr/bin/wifi-agent.sh recover-radio"

# Explicit, persistent operator kill switch - added 2026-08-11. Before
# this, disabling automation meant chmod-ing this whole init script
# non-executable AND removing it from /etc/rc.d AND clearing the crontab
# line by hand - three separate steps, and missing any one of them meant
# the next reboot silently re-registered the cron line via start() below,
# undoing a manual disable without any obvious sign it had happened. That
# ambiguity cost real time during the 2026-08 incident. Now there's one
# file to touch/remove and this script respects it consistently across
# every boot:
#   touch /etc/wifi-agent-disabled   # disable both the boot check and cron
#   rm /etc/wifi-agent-disabled      # re-enable on the next boot
DISABLE_MARKER="/etc/wifi-agent-disabled"

start() {
    if [ -e "$DISABLE_MARKER" ]; then
        logger -t wifi-agent-boot "$DISABLE_MARKER present - skipping boot-time radio check and cron registration"
        return 0
    fi

    /usr/bin/wifi-agent.sh recover-radio

    crontab_file="/etc/crontabs/root"
    touch "$crontab_file"
    if ! grep -qF "$CRON_MARKER" "$crontab_file"; then
        echo "$CRON_LINE" >> "$crontab_file"
        /etc/init.d/cron enabled || /etc/init.d/cron enable
        /etc/init.d/cron restart
    fi
}
