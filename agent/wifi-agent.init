#!/bin/sh /etc/rc.common
# Install as /etc/init.d/wifi-agent
START=99
USE_PROCD=1

start_service() {
    [ -f /etc/wifi-agent.conf ] && . /etc/wifi-agent.conf

    procd_open_instance
    procd_set_param command /usr/bin/wifi-agent.sh
    procd_set_param env AGENT_ROLE="$AGENT_ROLE" AGENT_SERVER_URL="$AGENT_SERVER_URL" AGENT_API_TOKEN="$AGENT_API_TOKEN"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
